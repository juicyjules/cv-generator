<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'CV Generator' }) %>
</head>
<body>
  <%- include('partials/navbar', { user: user }) %>
  <div class="container">
    <div class="card">
      <h1>Welcome to the CV Generator</h1>
      <p style="text-align: center; color: white;">The best place to create, manage, and share your CVs.</p>
