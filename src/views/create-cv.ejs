<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create CV</title>
</head>
<body>
  <h1>Create CV</h1>
  <form id="create-cv-form">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" required>
    <br>
    <label for="content">Content (JSON):</label>
    <textarea id="content" name="content" rows="10" required></textarea>
    <br>
    <button type="submit">Create</button>
  </form>

  <script>
    document.getElementById('create-cv-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const title = document.getElementById('title').value;
      const content = document.getElementById('content').value;
      try {
        const response = await fetch('/api/cvs', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title, content: JSON.parse(content) }),
        });
        if (response.ok) {
          window.location.href = '/dashboard';
        } else {
          alert('Error creating CV');
        }
      } catch (error) {
        console.error('Error creating CV:', error);
        alert('Error creating CV');
      }
    });
  </script>
</body>
</html>
