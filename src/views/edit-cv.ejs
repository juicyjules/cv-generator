<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit CV</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="container">
    <div class="card">
      <h1 id="cv-title">Edit CV</h1>
      <form id="edit-cv-form">
        <input type="hidden" id="cvId" value="<%= cvId %>">
        <label for="title">Title:</label>
        <input type="text" id="title" name="title" required>
        <button type="submit">Update Title</button>
      </form>
      <hr>
      <h2>Biography</h2>
      <form id="biography-form">
        <textarea id="biography-content"></textarea>
        <button type="submit">Save Biography</button>
      </form>
      <hr>
      <button id="delete-cv-button" class="delete-button">Delete CV</button>
    </div>
  </div>

  <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
  <script>
    tinymce.init({
      selector: '#biography-content',
      plugins: 'autolink lists link image charmap print preview hr anchor pagebreak',
      toolbar_mode: 'floating',
      skin: "oxide-dark",
      content_css: "dark"
    });

    document.addEventListener('DOMContentLoaded', async () => {
      const cvId = document.getElementById('cvId').value;
      const titleInput = document.getElementById('title');
      const cvTitle = document.getElementById('cv-title');

      try {
        const response = await fetch(`/api/cvs/${cvId}`);
        if (response.ok) {
          const cv = await response.json();
          titleInput.value = cv.title;
          cvTitle.textContent = `Edit CV: ${cv.title}`;
          if (cv.biography) {
            tinymce.get('biography-content').setContent(cv.biography.content);
          }
        } else {
          window.location.href = '/dashboard';
        }
      } catch (error) {
        console.error('Error fetching CV:', error);
      }
    });

    document.getElementById('biography-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const cvId = document.getElementById('cvId').value;
      const content = tinymce.get('biography-content').getContent();
      try {
        const response = await fetch(`/api/biography/${cvId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (response.ok) {
          alert('Biography saved successfully!');
        } else {
          alert('Error saving biography.');
        }
      } catch (error) {
        console.error('Error saving biography:', error);
        alert('An error occurred while saving the biography.');
      }
    });

    document.getElementById('edit-cv-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const cvId = document.getElementById('cvId').value;
      const title = document.getElementById('title').value;
      try {
        const response = await fetch(`/api/cvs/${cvId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title }),
        });
        if (response.ok) {
          location.reload();
        } else {
          alert('Error updating CV title');
        }
      } catch (error) {
        console.error('Error updating CV title:', error);
        alert('Error updating CV title.');
      }
    });

    document.getElementById('delete-cv-button').addEventListener('click', async () => {
      const cvId = document.getElementById('cvId').value;
      if (confirm('Are you sure you want to delete this CV?')) {
        try {
          const response = await fetch(`/api/cvs/${cvId}`, {
            method: 'DELETE',
          });
          if (response.ok) {
            window.location.href = '/dashboard';
          } else {
            alert('Error deleting CV');
          }
        } catch (error) {
          console.error('Error deleting CV:', error);
          alert('Error deleting CV');
        }
      }
    });
  </script>
  <style>
    .delete-button {
      background: linear-gradient(135deg, #ff416c, #ff4b2b);
      margin-top: 15px;
      box-shadow: 0 4px 15px 0 rgba(255, 75, 43, 0.75);
    }
    .delete-button:hover {
      box-shadow: 0 8px 25px 0 rgba(255, 75, 43, 0.75);
    }
    pre {
      background: rgba(0,0,0,0.2);
      color: white;
      padding: 15px;
      border-radius: 10px;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
    hr {
      border: none;
      border-top: 1px solid rgba(255,255,255,0.2);
      margin: 20px 0;
    }
  </style>
</body>
</html>
