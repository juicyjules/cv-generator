<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head', { title: 'Edit CV' }) %>
  <style>
    .vertical-nav {
      width: 200px;
      background: rgba(255,255,255,0.05);
      padding: 15px;
      border-right: 1px solid var(--card-border-color);
      align-self: stretch;
    }
    .vertical-nav .nav-item {
      display: block;
      color: var(--text-color-light);
      padding: 15px;
      text-decoration: none;
      border-radius: 5px;
      margin-bottom: 5px;
    }
    .vertical-nav .nav-item:hover {
      background-color: rgba(255,255,255,0.1);
    }
    .vertical-nav .nav-item.active {
      background-color: rgba(255,255,255,0.2);
    }
    .content-area {
      flex-grow: 1;
      padding: 20px;
    }
    .tab-content {
      display: none;
    }
  </style>
</head>
<body>
  <%- include('../partials/navbar', { user: user }) %>
  <div class="container">
    <div class="card" style="display: flex; flex-direction: row; align-items: flex-start; padding: 0;">
      <div class="vertical-nav">
        <a href="#" class="nav-item active" onclick="openTab(event, 'general')">General</a>
        <a href="#" class="nav-item" onclick="openTab(event, 'biography')">Biography</a>
        <a href="#" class="nav-item" onclick="openTab(event, 'skills')">Skills</a>
        <a href="#" class="nav-item" onclick="openTab(event, 'education')">Education</a>
        <a href="#" class="nav-item" onclick="openTab(event, 'projects')">Projects</a>
        <a href="#" class="nav-item" onclick="openTab(event, 'experience')">Experience</a>
      </div>
      <div class="content-area">
        <%- include('partials/cv-edit-sections/general', { cvId: cvId }) %>
        <%- include('partials/cv-edit-sections/biography') %>
        <%- include('partials/cv-edit-sections/skills') %>
        <%- include('partials/cv-edit-sections/education') %>
        <%- include('partials/cv-edit-sections/projects') %>
        <%- include('partials/cv-edit-sections/experience') %>
      </div>
    </div>
  </div>

  <%- include('partials/cv-edit-modals') %>
  <%- include('../partials/scripts') %>
  <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
  <script src="/js/edit-cv.js"></script>
  <script>
    function openTab(evt, tabName) {
      var i, tabcontent, navitems;
      tabcontent = document.getElementsByClassName("tab-content");
      for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.display = "none";
      }
      navitems = document.getElementsByClassName("nav-item");
      for (i = 0; i < navitems.length; i++) {
        navitems[i].className = navitems[i].className.replace(" active", "");
      }
      document.getElementById(tabName).style.display = "block";
      evt.currentTarget.className += " active";
    }
  </script>
</body>
</html>
