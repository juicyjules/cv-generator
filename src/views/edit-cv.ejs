<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Edit CV' }) %>
</head>
<body>
  <div class="container">
    <div class="card">
      <h1 id="cv-title">Edit CV</h1>
      <div class="tabs">
        <button class="tab-link active" onclick="openTab(event, 'general')">General</button>
        <button class="tab-link" onclick="openTab(event, 'biography')">Biography</button>
        <button class="tab-link" onclick="openTab(event, 'skills')">Skills</button>
        <button class="tab-link" onclick="openTab(event, 'education')">Education</button>
        <button class="tab-link" onclick="openTab(event, 'projects')">Projects</button>
        <button class="tab-link" onclick="openTab(event, 'experience')">Experience</button>
      </div>

      <div id="general" class="tab-content" style="display: block;">
        <h2>General</h2>
        <form id="edit-cv-form">
          <input type="hidden" id="cvId" value="<%= cvId %>">
          <label for="title">Title:</label>
          <input type="text" id="title" name="title" required>
          <button type="submit">Update Title</button>
        </form>
        <hr>
        <button id="delete-cv-button" class="delete-button">Delete CV</button>
      </div>

      <div id="biography" class="tab-content">
        <h2>Biography</h2>
        <form id="biography-form">
          <textarea id="biography-content"></textarea>
          <button type="submit">Save Biography</button>
        </form>
      </div>

      <div id="skills" class="tab-content">
        <h2>Skills</h2>
        <!-- Skills management UI will go here -->
        <p style="color: white;">Coming soon...</p>
      </div>

      <div id="education" class="tab-content">
        <h2>Education</h2>
        <!-- Education management UI will go here -->
        <p style="color: white;">Coming soon...</p>
      </div>

      <div id="projects" class="tab-content">
        <h2>Projects</h2>
        <!-- Projects management UI will go here -->
        <p style="color: white;">Coming soon...</p>
      </div>

      <div id="experience" class="tab-content">
        <h2>Work Experience</h2>
        <!-- Experience management UI will go here -->
        <p style="color: white;">Coming soon...</p>
      </div>
    </div>
  </div>

  <%- include('partials/scripts') %>
  <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/5/tinymce.min.js" referrerpolicy="origin"></script>
  <script>
    tinymce.init({
      selector: '#biography-content',
      plugins: 'autolink lists link image charmap print preview hr anchor pagebreak',
      toolbar_mode: 'floating',
      skin: "oxide-dark",
      content_css: "dark"
    });

    document.addEventListener('DOMContentLoaded', async () => {
      const cvId = document.getElementById('cvId').value;
      const titleInput = document.getElementById('title');
      const cvTitle = document.getElementById('cv-title');

      try {
        const response = await fetch(`/api/cvs/${cvId}`);
        if (response.ok) {
          const cv = await response.json();
          titleInput.value = cv.title;
          cvTitle.textContent = `Edit CV: ${cv.title}`;
          if (cv.biography) {
            tinymce.get('biography-content').setContent(cv.biography.content);
          }
        } else {
          window.location.href = '/dashboard';
        }
      } catch (error) {
        toastr.error('Error fetching CV details.');
      }
    });

    document.getElementById('biography-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const cvId = document.getElementById('cvId').value;
      const content = tinymce.get('biography-content').getContent();
      try {
        const response = await fetch(`/api/biography/${cvId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (response.ok) {
          toastr.success('Biography saved successfully!');
        } else {
          toastr.error('Error saving biography.');
        }
      } catch (error) {
        toastr.error('An error occurred while saving the biography.');
      }
    });

    document.getElementById('edit-cv-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const cvId = document.getElementById('cvId').value;
      const title = document.getElementById('title').value;
      try {
        const response = await fetch(`/api/cvs/${cvId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title }),
        });
        if (response.ok) {
          toastr.success('CV title updated successfully.');
          document.getElementById('cv-title').textContent = `Edit CV: ${title}`;
        } else {
          toastr.error('Error updating CV title.');
        }
      } catch (error) {
        toastr.error('An error occurred while updating the CV title.');
      }
    });

    document.getElementById('delete-cv-button').addEventListener('click', async () => {
      const cvId = document.getElementById('cvId').value;
      if (confirm('Are you sure you want to delete this CV?')) {
        try {
          const response = await fetch(`/api/cvs/${cvId}`, {
            method: 'DELETE',
          });
          if (response.ok) {
            toastr.success('CV deleted successfully. Redirecting to dashboard...');
            setTimeout(() => window.location.href = '/dashboard', 2000);
          } else {
            toastr.error('Error deleting CV.');
          }
        } catch (error) {
          toastr.error('An error occurred while deleting the CV.');
        }
      }
    });
  </script>
  <script>
    function openTab(evt, tabName) {
      var i, tabcontent, tablinks;
      tabcontent = document.getElementsByClassName("tab-content");
      for (i = 0; i < tabcontent.length; i++) {
        tabcontent[i].style.display = "none";
      }
      tablinks = document.getElementsByClassName("tab-link");
      for (i = 0; i < tablinks.length; i++) {
        tablinks[i].className = tablinks[i].className.replace(" active", "");
      }
      document.getElementById(tabName).style.display = "block";
      evt.currentTarget.className += " active";
    }
  </script>
  <style>
    .tabs {
      overflow: hidden;
      border-bottom: 1px solid rgba(255,255,255,0.2);
      margin-bottom: 20px;
    }
    .tab-link {
      background-color: inherit;
      float: left;
      border: none;
      outline: none;
      cursor: pointer;
      padding: 14px 16px;
      transition: 0.3s;
      color: white;
      font-size: 17px;
    }
    .tab-link:hover {
      background-color: rgba(255,255,255,0.1);
    }
    .tab-link.active {
      background-color: rgba(255,255,255,0.2);
    }
    .tab-content {
      display: none;
      padding: 6px 12px;
      border-top: none;
    }
    .delete-button {
      background: linear-gradient(135deg, #ff416c, #ff4b2b);
      margin-top: 15px;
      box-shadow: 0 4px 15px 0 rgba(255, 75, 43, 0.75);
    }
    .delete-button:hover {
      box-shadow: 0 8px 25px 0 rgba(255, 75, 43, 0.75);
    }
    pre {
      background: rgba(0,0,0,0.2);
      color: white;
      padding: 15px;
      border-radius: 10px;
      white-space: pre-wrap;
      word-wrap: break-word;
    }
    hr {
      border: none;
      border-top: 1px solid rgba(255,255,255,0.2);
      margin: 20px 0;
    }
  </style>
</body>
</html>
