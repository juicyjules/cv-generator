<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit CV</title>
</head>
<body>
  <h1>Edit CV</h1>
  <form id="edit-cv-form">
    <input type="hidden" id="cvId" value="<%= cvId %>">
    <label for="title">Title:</label>
    <input type="text" id="title" name="title" required>
    <br>
    <label for="content">Content (JSON):</label>
    <textarea id="content" name="content" rows="10" required></textarea>
    <br>
    <button type="submit">Update</button>
  </form>
  <button id="delete-cv-button">Delete</button>

  <script>
    document.addEventListener('DOMContentLoaded', async () => {
      const cvId = document.getElementById('cvId').value;
      const titleInput = document.getElementById('title');
      const contentInput = document.getElementById('content');

      try {
        const response = await fetch(`/api/cvs/${cvId}`);
        if (response.ok) {
          const cv = await response.json();
          titleInput.value = cv.title;
          contentInput.value = JSON.stringify(cv.content, null, 2);
        } else {
          window.location.href = '/dashboard';
        }
      } catch (error) {
        console.error('Error fetching CV:', error);
      }
    });

    document.getElementById('edit-cv-form').addEventListener('submit', async (event) => {
      event.preventDefault();
      const cvId = document.getElementById('cvId').value;
      const title = document.getElementById('title').value;
      const content = document.getElementById('content').value;
      try {
        const response = await fetch(`/api/cvs/${cvId}`, {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ title, content: JSON.parse(content) }),
        });
        if (response.ok) {
          window.location.href = '/dashboard';
        } else {
          alert('Error updating CV');
        }
      } catch (error) {
        console.error('Error updating CV:', error);
        alert('Error updating CV');
      }
    });

    document.getElementById('delete-cv-button').addEventListener('click', async () => {
      const cvId = document.getElementById('cvId').value;
      if (confirm('Are you sure you want to delete this CV?')) {
        try {
          const response = await fetch(`/api/cvs/${cvId}`, {
            method: 'DELETE',
          });
          if (response.ok) {
            window.location.href = '/dashboard';
          } else {
            alert('Error deleting CV');
          }
        } catch (error) {
          console.error('Error deleting CV:', error);
          alert('Error deleting CV');
        }
      }
    });
  </script>
</body>
</html>
