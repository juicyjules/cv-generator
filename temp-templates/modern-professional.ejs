<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title><%= cv.title %></title>
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <img src="<%= photoBase64 %>" alt="Profile Picture" class="profile-pic">

            <div class="contact-info section">
                <h2>Contact</h2>
                <p><strong>Email:</strong> <%= user.email %></p>
                <!-- Add more contact fields if they exist -->
            </div>

            <% if (cv.skills && cv.skills.length) { %>
            <div class="skills-list section">
                <h2>Skills</h2>
                <ul>
                    <% cv.skills.forEach(skill => { %>
                        <li><%= skill.name %> - <em><%= skill.level %></em></li>
                    <% }) %>
                </ul>
            </div>
            <% } %>
        </div>

        <div class="main-content">
            <h1><%= user.name || 'Your Name' %></h1>
            <div class="biography section">
                <h2>About Me</h2>
                <%- cv.biography ? cv.biography.content : '' %>
            </div>

            <% if (cv.experiences && cv.experiences.length) { %>
            <div class="experience section">
                <h2>Work Experience</h2>
                <% cv.experiences.forEach(exp => { %>
                    <div class="job">
                        <h3><%= exp.position %> at <%= exp.company %></h3>
                        <p class="date"><%= new Date(exp.startDate).toLocaleDateString() %> - <%= exp.endDate ? new Date(exp.endDate).toLocaleDateString() : 'Present' %></p>
                        <div><%- exp.description %></div>
                    </div>
                <% }) %>
            </div>
            <% } %>

            <% if (cv.educations && cv.educations.length) { %>
            <div class="education section">
                <h2>Education</h2>
                <% cv.educations.forEach(edu => { %>
                    <div class="edu-item">
                        <h3><%= edu.degree %> - <%= edu.institution %></h3>
                        <p class="date"><%= new Date(edu.startDate).toLocaleDateString() %> - <%= edu.endDate ? new Date(edu.endDate).toLocaleDateString() : 'Present' %></p>
                        <div><%- edu.description %></div>
                    </div>
                <% }) %>
            </div>
            <% } %>

            <% if (cv.projects && cv.projects.length) { %>
            <div class="projects section">
                <h2>Projects</h2>
                <% cv.projects.forEach(proj => { %>
                    <div class="project-item">
                        <h3><%= proj.name %></h3>
                        <% if (proj.url) { %><p><a href="<%= proj.url %>"><%= proj.url %></a></p><% } %>
                        <div><%- proj.description %></div>
                    </div>
                <% }) %>
            </div>
            <% } %>
        </div>
    </div>
</body>
</html>
